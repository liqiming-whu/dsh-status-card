{
  "name": "dsh-status-card",
  "version": "0.3.1",
  "description": "Inject a configurable dsh-ui status card instruction before every DSH agent reply",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "genui", "status-card"],
  "repository": { "type": "git", "url": "git+https://github.com/liqiming-whu/dsh-status-card.git" },
  "homepage": "https://github.com/liqiming-whu/dsh-status-card#readme",
  "bugs": { "url": "https://github.com/liqiming-whu/dsh-status-card/issues" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/client.d.cts", "default": "./lib/client.cjs" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README_EN.md", "docs/images/templates", "scripts/generate-card-images.mjs", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@changfenhuang/dsh-genui",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "images": "node scripts/generate-card-images.mjs",
    "check": "tsc --noEmit && pnpm run build && node test/injection.test.mjs && node test/loader-settings.test.mjs && node test/settings.test.mjs && node test/templates.test.mjs",
    "test": "pnpm run build && node test/injection.test.mjs && node test/loader-settings.test.mjs && node test/settings.test.mjs && node test/templates.test.mjs",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "18.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=11.7.0 <12"
  },
  "license": "MIT"
}
